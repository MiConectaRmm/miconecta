<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="MIConecta Agent"
           Manufacturer="Maginf Tecnologia"
           Version="!(bind.FileVersion.AgentExe)"
           UpgradeCode="E7A3B1C2-4D5F-6A7B-8C9D-0E1F2A3B4C5D"
           Scope="perMachine"
           Language="1046"
           Codepage="1252"
           InstallerVersion="500">

    <SummaryInformation Description="Agente de monitoramento e suporte remoto da MIConecta"
                        Manufacturer="Maginf Tecnologia" />

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do MIConecta Agent já está instalada." />

    <Media Id="1" Cabinet="agent.cab" EmbedCab="yes" CompressionLevel="high" />

    <!-- Properties for silent install: msiexec /i Setup.msi SERVER_URL=... TENANT_ID=... PROVISION_TOKEN=... -->
    <Property Id="SERVER_URL" Value="https://api.maginf.com.br/api/v1" />
    <Property Id="TENANT_ID" Secure="yes" />
    <Property Id="PROVISION_TOKEN" Secure="yes" />
    <Property Id="RUSTDESK_SERVER" Value="136.248.114.218" />
    <Property Id="RUSTDESK_KEY" Value="ev3ic04E+VsgunfupaellTSWgSzmHiQL2H5ywzBE+yI=" />

    <WixVariable Id="WixUILicenseRtf" Value="..\assets\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="..\assets\installer-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="..\assets\installer-dialog.bmp" />

    <!-- Install directory -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MIConecta">
        <Directory Id="LogsFolder" Name="logs" />
        <Directory Id="TrayFolder" Name="tray" />
      </Directory>
    </StandardDirectory>

    <!-- Agent files: ALL files from publish\agent EXCEPT the main exe (handled in AgentService component) -->
    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\agent\**">
        <Exclude Files="$(var.PublishDir)\agent\MIConectaAgent.exe" />
      </Files>
    </ComponentGroup>

    <!-- Tray files: in subfolder tray\ to avoid DLL conflicts with agent -->
    <ComponentGroup Id="TrayFiles" Directory="TrayFolder">
      <Files Include="$(var.PublishDir)\tray\**" />
    </ComponentGroup>

    <!-- Service component: contains the agent exe + service definition -->
    <Component Id="AgentService" Directory="INSTALLFOLDER" Guid="A1B2C3D4-E5F6-7A8B-9C0D-E1F2A3B4C5D6">
      <File Id="AgentExe"
            Source="$(var.PublishDir)\agent\MIConectaAgent.exe"
            KeyPath="yes" />

      <ServiceInstall Id="MIConectaService"
                      Name="MIConectaRMMAgent"
                      DisplayName="MIConecta Agent"
                      Description="Agente de monitoramento e suporte remoto da MIConecta"
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem" />

      <ServiceControl Id="StopMIConectaService"
                      Name="MIConectaRMMAgent"
                      Stop="both"
                      Remove="uninstall"
                      Wait="no" />
    </Component>

    <!-- WriteConfig.ps1 script -->
    <Component Id="ConfigScript" Directory="INSTALLFOLDER" Guid="D4E5F6A7-B8C9-0D1E-2F3A-B4C5D6E7F8A9">
      <File Id="WriteConfigPs1"
            Source="WriteConfig.ps1"
            KeyPath="yes" />
    </Component>

    <!-- Tray auto-start for all users -->
    <Component Id="TrayAutoStart" Directory="INSTALLFOLDER" Guid="E5F6A7B8-C9D0-1E2F-3A4B-C5D6E7F8A9B0">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                     Name="MIConectaTray"
                     Type="string"
                     Value="[INSTALLFOLDER]tray\MIConectaTray.exe"
                     KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut: MIConecta Chat (opens portal chat in browser) -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopChatShortcut" Guid="B1C2D3E4-F5A6-7B8C-9D0E-1F2A3B4C5D6E">
        <Shortcut Id="ChatDesktopShortcut"
                  Name="MIConecta Chat"
                  Description="Abrir chat de suporte MIConecta"
                  Target="[INSTALLFOLDER]tray\MIConectaTray.exe"
                  Arguments="--chat"
                  WorkingDirectory="TrayFolder"
                  Icon="ChatIcon" />
        <RegistryValue Root="HKCU" Key="Software\MIConecta" Name="DesktopChatInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Start Menu shortcuts -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MIConectaMenuFolder" Name="MIConecta">
        <Component Id="MenuShortcuts" Guid="F6A7B8C9-D0E1-2F3A-4B5C-D6E7F8A9B0C1">
          <Shortcut Id="TrayShortcut"
                    Name="MIConecta Agent"
                    Target="[INSTALLFOLDER]tray\MIConectaTray.exe"
                    WorkingDirectory="TrayFolder"
                    Icon="TrayIcon" />
          <Shortcut Id="ChatMenuShortcut"
                    Name="MIConecta Chat"
                    Description="Abrir chat de suporte MIConecta"
                    Target="[INSTALLFOLDER]tray\MIConectaTray.exe"
                    Arguments="--chat"
                    WorkingDirectory="TrayFolder"
                    Icon="ChatIcon" />
          <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\MIConecta" Name="MenuInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Icon Id="TrayIcon" SourceFile="..\assets\miconecta.ico" />
    <Icon Id="ChatIcon" SourceFile="..\assets\miconecta.ico" />
    <Property Id="ARPPRODUCTICON" Value="TrayIcon" />

    <!-- Feature tree -->
    <Feature Id="Complete" Title="MIConecta Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
      <ComponentGroupRef Id="TrayFiles" />
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="ConfigScript" />
      <ComponentRef Id="TrayAutoStart" />
      <ComponentRef Id="DesktopChatShortcut" />
      <ComponentRef Id="MenuShortcuts" />
    </Feature>

    <!-- Config file creation is handled by the install script (.bat/.ps1) after MSI install -->
    <!-- The MSI only installs files and registers the service -->

    <InstallExecuteSequence />


    <!-- UI -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>
